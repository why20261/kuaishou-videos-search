{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "title": "快手视频评论 - results 元素",
    "description": "评论成功时 results 数组中的一条。空字符串和数字 0 可能不返回。整份 stdout 见 output_envelope.schema.json。",
    "properties": {
        "comment_id": { "type": "number", "description": "评论 ID" },
        "content": { "type": "string", "description": "评论内容" },
        "timestamp": { "type": "number", "description": "评论时间戳。文档未写秒或毫秒" },
        "created_at": { "type": "string", "description": "评论时间" },
        "liked_count": { "type": "number", "description": "点赞数" },
        "sub_comment_count": { "type": "number", "description": "评论回复数" },
        "author_name": { "type": "string", "description": "评论者名称" },
        "author_area": { "type": "string", "description": "评论者区域" },
        "user_sex": { "type": "string", "description": "评论者性别。文档未给枚举" },
        "author_id": { "type": "number", "description": "评论者 UID" }
    }
}
