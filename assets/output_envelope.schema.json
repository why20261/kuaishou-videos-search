{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "title": "命令输出信封",
    "description": "三个命令 stdout 的统一结构。成功、空结果、错误都使用本信封。stderr 只有日志，不是本结构。",
    "required": [
        "status",
        "error_code",
        "message",
        "timestamp",
        "request",
        "metadata",
        "results"
    ],
    "properties": {
        "status": {
            "type": "string",
            "enum": ["success", "empty", "error"],
            "description": "success 为有结果；empty 为没有匹配内容，退出码仍为 0；error 为失败"
        },
        "error_code": {
            "type": "string",
            "description": "OK、NO_MATCH、INVALID_KEYWORD、INVALID_URL、INVALID_ARGS、AUTH_REQUIRED、AUTH_ERROR、TIMEOUT、NETWORK_ERROR、HTTP_5xx、HTTP_429、API_ERROR，或接口 errcode 的十进制字符串"
        },
        "message": {
            "type": "string",
            "description": "给人读的说明"
        },
        "timestamp": {
            "type": "string",
            "description": "输出时间，北京时间，格式如 2026/9/4 20:13:20，月和日不补零"
        },
        "request": {
            "type": "object",
            "description": "本次实际使用的参数。参数尚未解析成功时只有 command",
            "required": ["command"],
            "properties": {
                "command": {
                    "type": "string",
                    "enum": ["search", "post", "comment"],
                    "description": "命令名"
                },
                "keyword_raw": {
                    "type": "string",
                    "description": "搜索：用户原始关键词"
                },
                "keyword": {
                    "type": "string",
                    "description": "搜索：整理空白并去掉 emoji 后实际使用的关键词"
                },
                "sort": {
                    "type": "number",
                    "description": "搜索：0 综合，1 最新，2 最多点赞。作品：0 最新，1 最热"
                },
                "time": {
                    "type": "number",
                    "description": "搜索：0 不限，1 近 1 日，7 近 7 日，30 近 1 月"
                },
                "duration": {
                    "type": "number",
                    "description": "搜索：0 不限，1 1 分钟内，2 1-5 分钟，3 超过 5 分钟"
                },
                "url_raw": {
                    "type": "string",
                    "description": "作品或评论：用户原始链接或 id"
                },
                "url": {
                    "type": "string",
                    "description": "作品或评论：规范后的链接或 id"
                },
                "limit": {
                    "type": "number",
                    "description": "搜索、评论为 1-10000；作品为 0-10000。参数尚未通过校验时可能仍是用户传入的原值"
                }
            }
        },
        "metadata": {
            "type": "object",
            "required": ["skill_version", "runtime_version", "execution_time"],
            "properties": {
                "skill_version": { "type": "string", "description": "技能版本" },
                "runtime_version": { "type": "string", "description": "Node.js 版本" },
                "execution_time": {
                    "type": "number",
                    "description": "本次执行耗时，毫秒。未捕获异常时为 0"
                }
            }
        },
        "results": {
            "description": "error 与 empty 时为 null。搜索、评论成功时为数组。作品成功时为对象，含 post 和 user",
            "oneOf": [
                { "type": "null" },
                { "type": "array", "items": { "type": "object" } },
                { "type": "object" }
            ]
        }
    }
}
