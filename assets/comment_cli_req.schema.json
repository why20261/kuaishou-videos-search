{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "title": "快手视频评论 - 命令行入参",
    "description": "获取一条视频的评论。非法数量会直接失败，不会改成默认值。",
    "required": ["url"],
    "properties": {
        "url": {
            "type": "string",
            "maxLength": 255,
            "description": "视频链接或视频 id。支持 https://www.kuaishou.com/short-video/{id}、https://v.kuaishou.com/*，以及 3x 开头的视频 id。不接受博主主页和纯数字 user_id"
        },
        "limit": {
            "type": "number",
            "description": "评论数量",
            "minimum": 1,
            "maximum": 10000,
            "default": 10
        }
    },
    "additionalProperties": false
}
