{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "title": "快手关键词搜索 - 命令行入参",
    "description": "快手视频搜索的命令行参数。非法枚举或越界数量会直接失败，不会改成默认值。",
    "required": ["keyword"],
    "properties": {
        "keyword": {
            "type": "string",
            "description": "搜索关键词。1-50 个字符，不能是链接，不含 < > \" '",
            "minLength": 1,
            "maxLength": 50
        },
        "sort": {
            "type": "number",
            "description": "排序。0 综合，1 最新发布，2 最多点赞",
            "default": 0,
            "enum": [0, 1, 2]
        },
        "time": {
            "type": "number",
            "description": "发布时间。0 不限，1 近 1 日，7 近 7 日，30 近 1 月。这些数字就是对应天数，不是序号",
            "default": 0,
            "enum": [0, 1, 7, 30]
        },
        "duration": {
            "type": "number",
            "description": "视频时长。0 不限，1 1 分钟内，2 1-5 分钟，3 超过 5 分钟",
            "default": 0,
            "enum": [0, 1, 2, 3]
        },
        "limit": {
            "type": "number",
            "description": "返回数量",
            "minimum": 1,
            "maximum": 10000,
            "default": 10
        }
    },
    "additionalProperties": false
}
